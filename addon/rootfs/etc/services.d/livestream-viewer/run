#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

LOG_LEVEL="$(bashio::config 'log_level')"
DISPLAY_ENABLED="$(bashio::config 'display_enabled')"

export PATH="/opt/ffmpeg-8/bin:/usr/local/bin:${PATH:-/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin}"
export LD_LIBRARY_PATH="/opt/ffmpeg-8/lib:/opt/sdl3/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export SDL3_LIBRARY="${SDL3_LIBRARY:-/opt/sdl3/lib/libSDL3.so.0}"

# Container listen port is fixed to match ingress_port / ports 8099/tcp in config.yaml.
export LSV_HTTP_PORT="${LSV_HTTP_PORT:-8099}"
export LSV_HTTP_BIND="0.0.0.0"
export LSV_LOGGING_LEVEL="${LOG_LEVEL:-info}"
export LSV_DATABASE_PATH="${LSV_DATABASE_PATH:-/data/livestream-viewer.sqlite}"
export LSV_DATA_DIR="${LSV_DATA_DIR:-/data}"

if bashio::var.true "${DISPLAY_ENABLED}"; then
  export LSV_DISPLAY_ENABLED=true
else
  export LSV_DISPLAY_ENABLED=false
fi

export LSV_YOUTUBE_POT_MODE="${LSV_YOUTUBE_POT_MODE:-auto}"
export LSV_YOUTUBE_POT_SERVER_DIR="${LSV_YOUTUBE_POT_SERVER_DIR:-/opt/bgutil-pot}"

bashio::log.info "Refreshing yt-dlp (YouTube extractors)"
if command -v timeout >/dev/null 2>&1; then
  update_cmd=(timeout 45 python3 -m pip install --break-system-packages --upgrade --quiet 'yt-dlp[default]' bgutil-ytdlp-pot-provider)
else
  update_cmd=(python3 -m pip install --break-system-packages --upgrade --quiet 'yt-dlp[default]' bgutil-ytdlp-pot-provider)
fi
if "${update_cmd[@]}"; then
  bashio::log.info "yt-dlp is current"
else
  bashio::log.warning "yt-dlp self-update skipped or failed; using the image copy"
fi

bashio::log.info "Starting livestream-viewer on port ${LSV_HTTP_PORT}"
exec /usr/bin/livestream-viewer -frontend-embed=true
